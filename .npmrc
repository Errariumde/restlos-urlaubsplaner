# No install scripts from dependencies (supply-chain protection).
ignore-scripts=true
# Only install versions published at least 14 days ago (npm >= 11.10).
min-release-age=14
# Exact versions when adding packages.
save-exact=true
# Fail if the Node/npm version does not match "engines".
engine-strict=true
fund=false
audit=true
