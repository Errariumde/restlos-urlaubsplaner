# Claude Code sandbox: placeholders it mounts over protected paths that don't
# exist yet. They are only visible inside the sandbox, but there they would
# break `git add -A` and `reuse lint`. To share project agents, commands or
# hooks later, delete the matching line.
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.ripgreprc
/.idea
/.vscode
/.claude/agents
/.claude/commands
/.claude/hooks
/.claude/launch.json
/.claude/loop.md
/.claude/output-styles
/.claude/routines
/.claude/scheduled_tasks.json
/.claude/workflows
