{
  "name": "restlos-urlaubsplaner",
  "version": "0.0.0",
  "private": true,
  "description": "Offline vacation planner for bridge days and holidays",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.10"
  },
  "scripts": {
    "test": "vitest run --dir tests",
    "plan": "node --import ./scripts/ts-hooks.js scripts/plan.js",
    "perf": "node --import ./scripts/ts-hooks.js scripts/perf.js",
    "nixos-release": "node --import ./scripts/ts-hooks.js scripts/nixos-release.js",
    "lint": "eslint .",
    "typecheck": "tsc",
    "reference:python": "python3 scripts/python-holidays-reference.py tests/reference/python-holidays-de.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run perf && reuse lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "date-holidays": "3.37.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
